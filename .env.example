# Jira Cloud credentials. The account must be able to browse assigned issues.
JIRA_BASE_URL=https://your-company.atlassian.net
JIRA_EMAIL=automation@example.com
JIRA_API_TOKEN=replace-me

# Triage provider: openai or anthropic. OpenAI-compatible gateways can override
# OPENAI_BASE_URL (for example, a company gateway).
TRIAGE_PROVIDER=openai
OPENAI_API_KEY=replace-me
OPENAI_BASE_URL=https://api.openai.com/v1
TRIAGE_MODEL=gpt-4o-mini
# For Anthropic: set TRIAGE_PROVIDER=anthropic and ANTHROPIC_API_KEY.
ANTHROPIC_API_KEY=replace-me

# Optional Jira custom field id holding acceptance criteria (e.g. customfield_10050), and how many
# recent comments to send to triage/the agent.
JIRA_AC_FIELD=
JIRA_COMMENT_LIMIT=10

# Agent execution. Use an absolute path: cron's PATH does not include /opt/homebrew/bin.
AGENT_COMMAND=/opt/homebrew/bin/opencode
AGENT_MODEL=
# Optional JSON array of arguments. Use {prompt} where the prompt belongs.
# Default arguments are: ["run", "--standalone", "--auto", "--model", "$AGENT_MODEL", "{prompt}"]
AGENT_ARGS_JSON=
AGENT_TIMEOUT_MS=3600000
# OpenCode config applied to the agent (permissions + MCP servers off). Defaults to config/opencode.automation.json.
AGENT_OPENCODE_CONFIG=
# Comma-separated extra env vars forwarded to the agent (e.g. its own provider key). AWS_* and JIRA_* are never forwarded.
AGENT_ENV_PASSTHROUGH=

# Optional roots/paths. Defaults use the sibling repositories under HORNBLOWER_ROOT.
HORNBLOWER_ROOT=
PROJECT_ROOT=
SDK_REPO_PATH=anchor-commerce-sdk
SDK_BRANCH=main
DASHBOARD_REPO_PATH=dashboard
DASHBOARD_BRANCH=V3
API_REPO_PATH=commerce-api
API_BRANCH=V3

# Safety controls. A matching active local Claude/OpenCode process prevents agent execution.
SESSION_CHECK_ENABLED=true
# Posts an internal-note comment (never customer-visible) when worktree setup or the agent fails.
JIRA_COMMENT_ON_FAILURE=false
# Re-run tickets that already have a completed solutions/[TICKET-ID] package.
FORCE_RERUN=false
